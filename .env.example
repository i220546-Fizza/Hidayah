# Copy to .env and fill in locally. NEVER commit real values.

# Database (local Docker defaults; change in production)
POSTGRES_PASSWORD=change-me
# Host port 5433 maps to the container's 5432 (see docker-compose.yml). If you change
# HIDAYAH_DB_PORT, change the port in the two URLs as well.
HIDAYAH_DB_PORT=5433
DATABASE_URL=postgresql+psycopg://hidayah:change-me@localhost:5433/hidayah

# Backend
SECRET_KEY=generate-a-long-random-value
ALLOWED_ORIGINS=http://localhost:5173

# LLM and embeddings (provider-agnostic adapter; set the one you use)
LLM_PROVIDER=anthropic
LLM_API_KEY=
EMBEDDING_PROVIDER=
EMBEDDING_API_KEY=

# Email (verification and password reset)
SMTP_HOST=
SMTP_USER=
SMTP_PASSWORD=

# Web / mobile
VITE_API_BASE_URL=http://localhost:8000/api/v1
EXPO_PUBLIC_API_BASE_URL=http://localhost:8000/api/v1

# Tests use a separate throwaway database (must end in _test; it is dropped and recreated)
TEST_DATABASE_URL=postgresql+psycopg://hidayah:change-me@localhost:5433/hidayah_test
